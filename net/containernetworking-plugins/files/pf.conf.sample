# Change these to the interface(s) with the default route
v4egress_if = "ix0"
v6egress_if = "ix0"

table <cni-nat>

match out on $v4egress_if inet from <cni-nat> to any nat-to ($v4egress_if)
match out on $v6egress_if inet6 from <cni-nat> to !ff00::/8 nat-to ($v6egress_if)

# Port redirections are loaded into anchors nested under cni-rdr.
# OpenBSD PF has no rdr-anchor/nat-anchor: one anchor holds every rule type.
anchor "cni-rdr/*"
