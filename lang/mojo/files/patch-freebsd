+namespace {
+// MLIR keys pass timers by the pass object's address. Sequential pass managers
+// can reuse those addresses, so sharing one root directly merges unrelated
+// passes and loses their names. Give each manager a distinct, hidden parent.
+// The instrumentation keeps that scope alive until its pass manager is done.
+class PassManagerTimingScope final : public mlir::PassInstrumentation {
