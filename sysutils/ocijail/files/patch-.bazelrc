--- .bazelrc.orig	2026-09-01 09:14:54 UTC
+++ .bazelrc
@@ -1,3 +1,6 @@
 build --spawn_strategy local
 build --workspace_status_command=tools/git-status.sh
-build --experimental_repository_disable_download --distdir=distfiles
+build --distdir=distfiles
+# ocijail is FreeBSD-only: run sh_binary/sh_test with the base shell rather
+# than /bin/bash, which FreeBSD does not have.
+build --shell_executable=/bin/sh
